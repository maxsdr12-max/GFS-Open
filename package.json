{
  "name": "gfs-open",
  "version": "1.0.0",
  "description": "Eine klar gestaltete Desktop-Präsentationsvorlage für eine GFS. Das reduzierte Layout setzt auf Papierweiß, Schwarz und Rot statt auf typische KI-Verläufe.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxsdr12-max/gfs-open.git"
  },
  "keywords": [
    "presentation",
    "gfs",
    "slides",
    "editor"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/maxsdr12-max/gfs-open/issues"
  },
  "homepage": "https://github.com/maxsdr12-max/gfs-open#readme",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-legacy": "^5.2.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.40.0",
    "terser": "^5.24.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
